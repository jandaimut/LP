<style>
    :root {
        /* Palet Warna Neon Green & Hijau Muda */
        --gold-light: #76ff03;
        --gold-main: #00ff00;
        --gold-dark: #00c853;
        --bg-glass: rgba(15, 15, 18, 0.75);
        --glow-color: rgba(0, 255, 0, 0.6);
        --border-gold: rgba(118, 255, 3, 0.4);
    }

    .footer-floating-jg {
        position: fixed;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        width: 92%;
        max-width: 2000px;
        display: flex;
        gap: 12px;
        padding: 14px 20px;
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 40px;
        border: 1px solid var(--border-gold);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), inset 0 1px 3px rgba(255, 255, 255, 0.1);
        z-index: 9999;
    }

    /* BUTTON BASE LUXURY */
    .footer-btn-jg {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: 'Poppins', system-ui, sans-serif;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #000000;
        padding: 12px 8px;
        /* Gradasi Hijau Mewah */
        background: linear-gradient(135deg, var(--gold-light), var(--gold-main), var(--gold-dark));
        border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-decoration: none;
        user-select: none;
        white-space: nowrap;
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
        
        /* Animasi Gabungan: Naik Turun + Kedap Kedip Mewah */
        animation: floatUpDown 3s ease-in-out infinite, luxuryBlink 2s ease-in-out infinite;
    }

    /* ICON */
    .footer-btn-jg img {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }

    /* VARIASI TOMBOL UNTUK KONTRASTING (Khusus LOGIN / DAFTAR dibuat background hitam hijau agar selang-seling mewah) */
    .footer-btn-jg.login, .footer-btn-jg.link {
        background: linear-gradient(135deg, #2a2a2e, #151518, #000000);
        color: var(--gold-light);
        border: 1px solid var(--gold-main);
        text-shadow: none;
    }

    /* PERBEDAAN JEDA ANIMASI KEDAP KEDIP (Biar bergelombang) */
    .footer-btn-jg.promo { animation-delay: 0s, 0.2s; }
    .footer-btn-jg.login { animation-delay: 0.2s, 0.4s; }
    .footer-btn-jg.daftar { animation-delay: 0.4s, 0.6s; }
    .footer-btn-jg.link { animation-delay: 0.6s, 0.8s; }
    .footer-btn-jg.chat { animation-delay: 0.8s, 1s; }

    /* HOVER GLOW EFFECT */
    .footer-btn-jg:hover {
        transform: translateY(-5px) scale(1.03);
        color: #ffffff;
        background: linear-gradient(135deg, #000000, #1a1a1a);
        border-color: var(--gold-light);
        box-shadow: 0 0 20px var(--gold-main), 0 0 40px rgba(0, 255, 0, 0.4);
        text-shadow: 0 0 5px var(--gold-light);
    }
    
    .footer-btn-jg.login:hover, .footer-btn-jg.link:hover {
        color: #000000;
        background: linear-gradient(135deg, var(--gold-light), var(--gold-main));
        text-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
    }

    /* ANIMASI 1: KEDAP KEDIP AURA (LUXURY NEON BLINK) */
    @keyframes luxuryBlink {
        0%, 100% {
            box-shadow: 0 0 8px #00c853, inset 0 0 4px rgba(255, 255, 255, 0.2);
            filter: brightness(1);
        }
        50% {
            box-shadow: 0 0 25px var(--gold-main), 0 0 10px var(--gold-light), inset 0 0 8px rgba(255, 255, 255, 0.5);
            filter: brightness(1.25);
        }
    }

    /* ANIMASI 2: ALIRAN NAIK TURUN HALUS */
    @keyframes floatUpDown {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    /* RESPONSIVE LAYOUT */
    @media (max-width: 1024px) {
        .footer-floating-jg {
            flex-wrap: wrap;
            padding: 12px;
            border-radius: 20px;
            bottom: 10px;
        }
        .footer-btn-jg {
            flex: 1 1 calc(33.33% - 8px);
            font-size: 12px;
        }
        /* Membuat tombol terakhir menyesuaikan tempat */
        .footer-btn-jg.link, .footer-btn-jg.chat {
            flex: 1 1 calc(50% - 8px);
        }
    }

    @media (max-width: 600px) {
        .footer-floating-jg {
            gap: 6px;
            padding: 8px;
        }
        .footer-btn-jg {
            flex: 1 1 calc(50% - 4px);
            font-size: 11px;
            padding: 10px 6px;
        }
        .footer-btn-jg.promo {
            flex: 1 1 100%; /* Tombol promo full lebar di mobile agar menonjol */
        }
    }
</style>

