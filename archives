<script>
  function toggleLxFaq(button) {
    const faqItem = button.parentElement;
    const faqBody = button.nextElementSibling;
    const isOpen = faqItem.classList.contains('active');
    // Tutup semua FAQ lain
    document.querySelectorAll('.lx-faq-item').forEach(item => {
      item.classList.remove('active');
      item.querySelector('.lx-faq-body').style.maxHeight = null;
    });
    // Buka item yang diklik jika sebelumnya tertutup
    if (!isOpen) {
      faqItem.classList.add('active');
      faqBody.style.maxHeight = faqBody.scrollHeight + "px";
    }
  }
</script>
