    border: 1px solid #d4af37;
    border-radius: 16px;
    padding: 40px 35px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 15px rgba(212, 175, 55, 0.2);
    color: #ffffff;
    text-align: center;
    position: relative;
